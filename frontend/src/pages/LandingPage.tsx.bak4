// LandingPage.tsx — AQUANET X
// Full cinematic underwater world:
// • WebGL atmospheric sea surface & depth shader
// • Real-time 2D wave equation ripple simulation with cursor wake
// • Underwater terrain: layered rock boulders, vibrant coral reefs (staghorn, shelf, brain), swaying kelp forests
// • 6 Marine species: Silvery schooling anchovies, Tropical tangs, Pelagic tunas, Blacktip reef sharks, Giant manta ray, Colossal blue whale
// • Interactive click physics: surface fish breach-jump with splash + droplets, deep fish panic-burst with bubble trail
// • Cursor avoidance & water displacement
// • Scroll-driven depth transitions (0m to 40m)
// • Text reflection of AQUANET X beneath surface
// • Preserves 100% of original glassmorphism navigation, buttons, cards, typography, and layout.

import { useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';

export default function LandingPage() {
  const seaRef  = useRef<HTMLCanvasElement>(null);
  const fishRef = useRef<HTMLCanvasElement>(null);
  const ripRef  = useRef<HTMLCanvasElement>(null);
  const barRef  = useRef<HTMLDivElement>(null);
  const railRef = useRef<HTMLDivElement>(null);
  const dpRef   = useRef<HTMLElement>(null);
  const navRef  = useRef<HTMLElement>(null);
  const menuRef = useRef<HTMLDivElement>(null);
  const heroContentRef = useRef<HTMLDivElement>(null);
  const stepsRef = useRef<HTMLDivElement>(null);
  const fxRef   = useRef<HTMLDivElement>(null);
  const navigate = useNavigate();
  const { user }  = useAuth();

  const handleGetStarted = () => { navigate(user ? '/dashboard' : '/register'); };
  const handleLogin      = () => { navigate(user ? '/dashboard' : '/login'); };
  const handleExplore    = () => { document.getElementById('challenge')?.scrollIntoView({ behavior: 'smooth' }); };

  useEffect(() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const cv  = seaRef.current!;
    const fc  = fishRef.current!;
    const rc  = ripRef.current!;
    const fcx = fc.getContext('2d')!;
    const rcx = rc.getContext('2d')!;

    let gl: WebGLRenderingContext | null = null;
    const U: Record<string, WebGLUniformLocation | null> = {};
    let W = 0, H = 0, q = 0, t = 0, sy = 0, P = 0, boost = 0;
    let small = innerWidth < 760;
    let animId = 0;

    // ──────────────────────────────────────────────────────────────────────────
    // 1. GLSL FRAGMENT SHADER — Horizon, Water Surface & Sunlight
    // ──────────────────────────────────────────────────────────────────────────
    const FS = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 R;uniform float T,S,K,Dk,B,D;
float h(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(h(i),h(i+vec2(1.,0.)),f.x),mix(h(i+vec2(0.,1.)),h(i+1.),f.x),f.y);}
float fbm(vec2 p){float a=.5,s=0.;for(int i=0;i<4;i++){s+=a*n(p);p=p*2.03+17.;a*=.5;}return s;}
vec3 sky(float x,float e){
 vec3 c=mix(vec3(.96,.98,.99),vec3(.72,.87,.91),smoothstep(0.,.3,e));
 c=mix(c,vec3(.45,.67,.77),smoothstep(.25,1.,e)*.9);
 float cl=smoothstep(.5,.85,fbm(vec2(x*.9+T*.012,e*4.)+vec2(3.,T*.004)));
 c=mix(c,vec3(1.),cl*smoothstep(.02,.3,e)*.7);
 float sx=x-.2*R.x/R.y;
 return c+vec3(.95,.88,.7)*exp(-(sx*sx*6.+(e-.12)*(e-.12)*60.))*.35;}
void main(){
 vec2 p=gl_FragCoord.xy/R;float A=R.x/R.y,x2=(p.x-.5)*A;
 float hz=.40+S*.75,d=hz-p.y;vec3 col;
 if(d<=0.){
  float e=clamp((p.y-hz)/max(1.-hz,.25),0.,1.);
  col=sky(x2,e);
  float side=abs(p.x-.5)*1.8;
  float r1=hz+(.02+.12*fbm(vec2(x2*1.5+2.,.7)))*smoothstep(.1,.6,side);
  float r2=hz+(.008+.07*fbm(vec2(x2*2.7+9.,3.3)))*smoothstep(.3,.8,side);
  vec3 hc=vec3(.74,.87,.91);
  if(p.y<r1)col=mix(vec3(.5,.58,.62),hc,.6);
  if(p.y<r2){float tt=clamp((p.y-hz)/max(r2-hz,.004),0.,1.);col=mix(mix(vec3(.78,.72,.6),hc,.25),mix(vec3(.47,.5,.52),hc,.25),smoothstep(0.,.45,tt));}
  col=mix(col,vec3(.96,.98,.99),exp(-(p.y-hz)*14.)*.6);
 }else{
  float dd=max(d,.003),fo=smoothstep(0.,.25,dd);
  vec2 w=vec2(x2/dd,1./dd)*.6+vec2(0.,T*.5);vec2 sl=vec2(0.);
  for(int i=0;i<4;i++){float fi=float(i),an=.5+fi*1.1+.3*sin(T*.05+fi),fr=1.6+fi*1.35;vec2 dr=vec2(cos(an),sin(an));sl+=dr*fr*cos(dot(dr,w)*fr+T*(.9+fi*.35))*(.16/(1.+fi*.9));}
  sl+=(vec2(fbm(w*1.4+T*.15),fbm(w*1.4+7.-T*.12))-.5)*.5;
  sl*=mix(.2,1.,fo);
  vec3 N=normalize(vec3(-sl.x,1.,-sl.y)),V=normalize(vec3(-x2,dd*1.4+.03,-1.));
  float F=.03+.97*pow(1.-max(dot(N,V),0.),5.);
  vec3 Rf=reflect(-V,N);
  vec3 base=mix(vec3(.29,.61,.71),vec3(.09,.3,.39),smoothstep(0.,.5,dd));
  base=mix(base,vec3(.39,.81,.8),clamp(length(sl)*.3,0.,.3));
  col=mix(base,sky(x2+Rf.x*.5,clamp(Rf.y*1.3,0.,1.)),F);
  vec3 L=normalize(vec3(.2*A,.17,1.)),Hh=normalize(L+V);float nh=max(dot(N,Hh),0.);
  col+=vec3(.95,.88,.7)*(pow(nh,140.)*1.6+pow(nh,18.)*.1);
  col=mix(col,vec3(.94,.98,.99),smoothstep(.5,.85,fbm(w*2.2+vec2(0.,T*.4)))*smoothstep(.15,.5,length(sl))*fo*.28);
  col+=vec3(.6,.85,.82)*(1.-smoothstep(0.,.07,abs(n(w*.9+T*.2)-n(w*.8-T*.18))))*.07*smoothstep(.1,.5,S)*fo;
  col=mix(col,vec3(.96,.98,.99),exp(-dd*8.)*.9);
 }
 col*=mix(1.,.45,Dk);
 float uw=smoothstep(.38,.92,S);
 if(uw>0.){
  vec3 uc=mix(vec3(.19,.5,.58),vec3(.035,.14,.21),smoothstep(0.,1.,D*1.1));
  uc=mix(uc,vec3(.1,.3,.37),pow(p.y,2.2)*(.6-.15*D));
  float rays=pow(.5+.5*sin(x2*5.+sin(T*.2+p.y*2.5)*1.4+T*.12),5.)*pow(p.y,1.5)*mix(.22,.2,D);
  vec2 cw=vec2(x2,p.y)*5.;float c=abs(n(cw+vec2(T*.25,T*.18))-n(cw*1.3-vec2(T*.2,-T*.22)));
  float cau=(1.-smoothstep(0.,.07,c))*.14*smoothstep(.2,1.,p.y)*(1.-D);
  uc+=vec3(.7,.9,.88)*(rays*(1.-.3*D)+cau);
  uc=mix(uc,vec3(.04,.15,.22),(1.-p.y)*.25*D);
  col=mix(col,uc,uw);
 }
 col*=1.-.5*dot(p-.5,p-.5);
 col+=vec3(.5,.8,.8)*B*exp(-length(p-.5)*2.5);
 gl_FragColor=vec4(clamp(col,0.,1.),1.);}`;

    try {
      gl = cv.getContext('webgl', { antialias: false, alpha: false });
      if (!gl) throw new Error('WebGL not available');
      const mk = (ty: number, src: string) => {
        const sh = gl!.createShader(ty)!;
        gl!.shaderSource(sh, src);
        gl!.compileShader(sh);
        if (!gl!.getShaderParameter(sh, gl!.COMPILE_STATUS)) throw new Error(gl!.getShaderInfoLog(sh) ?? '');
        return sh;
      };
      const pg = gl.createProgram()!;
      gl.attachShader(pg, mk(gl.VERTEX_SHADER, 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}'));
      gl.attachShader(pg, mk(gl.FRAGMENT_SHADER, FS));
      gl.linkProgram(pg);
      gl.useProgram(pg);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,3,-1,-1,3]), gl.STATIC_DRAW);
      const la = gl.getAttribLocation(pg, 'a');
      gl.enableVertexAttribArray(la);
      gl.vertexAttribPointer(la, 2, gl.FLOAT, false, 0, 0);
      ['R','T','S','K','Dk','B','D'].forEach(k => { U[k] = gl!.getUniformLocation(pg, k); });
    } catch(e) {
      gl = null;
      console.warn('[AQUANET X] WebGL ocean fallback active', e);
      document.body.style.background = 'linear-gradient(#b8dde8,#4a9cb4 55%,#0b2e42)';
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 2. REAL-TIME WAVE EQUATION RIPPLE ENGINE
    // ──────────────────────────────────────────────────────────────────────────
    const GRID_COLS = 120, GRID_ROWS = 60;
    let ripBuf0: Float32Array, ripBuf1: Float32Array, ripBufTmp: Float32Array;

    function initRipple() {
      const n = GRID_COLS * GRID_ROWS;
      ripBuf0 = new Float32Array(n);
      ripBuf1 = new Float32Array(n);
      ripBufTmp = new Float32Array(n);
    }
    initRipple();

    // ──────────────────────────────────────────────────────────────────────────
    // 3. RESIZE & PROJECTION CURVES
    // ──────────────────────────────────────────────────────────────────────────
    function rs() {
      W = innerWidth; H = innerHeight; small = W < 760;
      q = small ? 0.5 : 0.7;
      cv.width = Math.ceil(W * q); cv.height = Math.ceil(H * q);
      fc.width = W; fc.height = H;
      rc.width = W; rc.height = H;
      if (gl) gl.viewport(0, 0, cv.width, cv.height);
      initRipple();
    }
    rs();
    addEventListener('resize', rs);

    const CP: [number,number][] = [[0,0],[0.12,0.15],[0.27,0.55],[0.42,0.85],[0.58,1],[1,1]];
    const DP: [number,number][] = [[0,0],[0.2,0.2],[0.45,0.5],[0.7,0.8],[1,1]];
    function interp(T: [number,number][], p: number): number {
      for (let i = 1; i < T.length; i++) {
        if (p <= T[i][0]) {
          const a = T[i-1], b = T[i], k0 = (p - a[0]) / (b[0] - a[0]);
          const k = k0 * k0 * (3 - 2 * k0);
          return a[1] + (b[1] - a[1]) * k;
        }
      }
      return T[T.length-1][1];
    }
    const curve = (p: number) => interp(CP, p);

    function addRipple(nx: number, ny: number, strength = 1.5) {
      const gx = Math.floor(nx * GRID_COLS);
      const gy = Math.floor(ny * GRID_ROWS);
      for (let dy = -3; dy <= 3; dy++) {
        for (let dx = -3; dx <= 3; dx++) {
          const cx = gx + dx, cy = gy + dy;
          if (cx >= 0 && cx < GRID_COLS && cy >= 0 && cy < GRID_ROWS) {
            const dist = Math.sqrt(dx*dx + dy*dy);
            ripBuf0[cy * GRID_COLS + cx] += strength * Math.exp(-dist * 0.7);
          }
        }
      }
    }

    function stepRipple() {
      const damp = 0.985;
      for (let y = 1; y < GRID_ROWS - 1; y++) {
        for (let x = 1; x < GRID_COLS - 1; x++) {
          const i = y * GRID_COLS + x;
          const avg = (
            ripBuf0[(y-1)*GRID_COLS + x] +
            ripBuf0[(y+1)*GRID_COLS + x] +
            ripBuf0[y*GRID_COLS + (x-1)] +
            ripBuf0[y*GRID_COLS + (x+1)]
          ) * 0.5 - ripBuf1[i];
          ripBufTmp[i] = avg * damp;
        }
      }
      const tmp = ripBuf1;
      ripBuf1 = ripBuf0;
      ripBuf0 = ripBufTmp;
      ripBufTmp = tmp;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 4. UNDERWATER TERRAIN: ROCKS, CORAL REEFS & SWAYING KELP FORESTS
    // ──────────────────────────────────────────────────────────────────────────
    type RockFormation = {
      cx: number; w: number; h: number;
      pts: [number, number][]; layer: number; colorDark: string; colorLight: string;
    };
    const ROCKS: RockFormation[] = [];

    (function initRocks() {
      const count = small ? 10 : 16;
      for (let i = 0; i < count; i++) {
        const cx = (i / count) * 1.15 - 0.08 + (Math.random() - 0.5) * 0.06;
        const layer = i % 3; // 0=deep, 1=mid, 2=foreground
        const w = (small ? 110 : 180) + Math.random() * (small ? 90 : 180);
        const h = (small ? 90 : 140) + Math.random() * (small ? 80 : 160);

        const pts: [number, number][] = [];
        const numPts = 9;
        for (let p = 0; p < numPts; p++) {
          const angle = Math.PI + (p / (numPts - 1)) * Math.PI;
          const radVar = 0.8 + Math.random() * 0.4;
          pts.push([Math.cos(angle) * (w * 0.5) * radVar, Math.sin(angle) * h * radVar]);
        }
        ROCKS.push({
          cx, w, h, pts, layer,
          colorDark: layer === 0 ? '#0B2332' : layer === 1 ? '#11354A' : '#1A4A66',
          colorLight: layer === 0 ? '#1C4A60' : layer === 1 ? '#2E6D8A' : '#4592B5',
        });
      }
    })();

    type CoralReef = {
      xFrac: number; yOffset: number; type: 'staghorn' | 'shelf' | 'brain';
      scale: number; color: string; accentColor: string;
    };
    const CORALS: CoralReef[] = [
      { xFrac: 0.07, yOffset: 70,  type: 'staghorn', scale: 1.6, color: '#FF6F61', accentColor: '#FFEAA7' },
      { xFrac: 0.18, yOffset: 110, type: 'shelf',    scale: 1.5, color: '#E17055', accentColor: '#FD79A8' },
      { xFrac: 0.31, yOffset: 55,  type: 'brain',    scale: 1.6, color: '#00B894', accentColor: '#55EFC4' },
      { xFrac: 0.48, yOffset: 120, type: 'staghorn', scale: 1.8, color: '#E056FD', accentColor: '#7ED6DF' },
      { xFrac: 0.65, yOffset: 85,  type: 'shelf',    scale: 1.7, color: '#6C5CE7', accentColor: '#A29BFE' },
      { xFrac: 0.80, yOffset: 65,  type: 'brain',    scale: 1.7, color: '#0984E3', accentColor: '#74B9FF' },
      { xFrac: 0.93, yOffset: 100, type: 'staghorn', scale: 1.5, color: '#FF7675', accentColor: '#FDCB6E' },
    ];

    type KelpFrond = {
      xFrac: number; height: number;
      bladeWidth: number; color: string; phase: number; speed: number;
    };
    const KELP: KelpFrond[] = [];
    (function initKelp() {
      const count = small ? 14 : 24;
      for (let i = 0; i < count; i++) {
        KELP.push({
          xFrac: (i / count) * 1.06 - 0.03 + (Math.random() - 0.5) * 0.05,
          height: (small ? 180 : 320) + Math.random() * (small ? 120 : 200),
          bladeWidth: 12 + Math.random() * 10,
          color: i % 2 === 0 ? 'rgba(0, 184, 148, 0.85)' : 'rgba(15, 120, 95, 0.85)',
          phase: Math.random() * Math.PI * 2,
          speed: 1.4 + Math.random() * 0.8,
        });
      }
    })();

    // ──────────────────────────────────────────────────────────────────────────
    // 5. AIR BUBBLE SYSTEM & MARINE SNOW
    // ──────────────────────────────────────────────────────────────────────────
    type AirBubble = {
      x: number; y: number; r: number; vy: number; wobbleSpeed: number; phase: number;
    };
    const BUBBLES: AirBubble[] = [];
    (function initBubbles() {
      for (let i = 0; i < (small ? 24 : 40); i++) {
        BUBBLES.push({
          x: Math.random() * (innerWidth || 800),
          y: Math.random() * (innerHeight || 600) + 100,
          r: 2.5 + Math.random() * 4.5,
          vy: 45 + Math.random() * 65,
          wobbleSpeed: 2.5 + Math.random() * 3,
          phase: Math.random() * Math.PI * 2,
        });
      }
    })();

    type Mote = { x: number; y: number; r: number; s: number; p: number; };
    const MS: Mote[] = [];
    for (let j = 0; j < (small ? 20 : 40); j++) {
      MS.push({ x: Math.random(), y: Math.random(), r: 1.0 + Math.random() * 1.8, s: 0.2 + Math.random() * 0.6, p: Math.random() * 6 });
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 6. MULTI-SPECIES MARINE LIFE & CREATURE SYSTEM
    // ──────────────────────────────────────────────────────────────────────────
    type CreatureType = 'school' | 'tropical' | 'tuna' | 'shark' | 'manta' | 'whale';

    type MarineCreature = {
      id: number; type: CreatureType;
      x: number; y: number; vx: number; vy: number;
      targetY: number; targetX: number;
      baseSpeed: number; dir: number;
      length: number; height: number;
      phase: number; z: number; ang: number; vis: number;
      minScroll: number; panicTimer: number;
      jumping: boolean; jumpVx: number; jumpVy: number;
      splashTimer: number; splashX: number; splashY: number;
    };

    const CREATURES: MarineCreature[] = [];
    let TR: number[][] = [];

    function mr() {
      TR = [];
      document.querySelectorAll('.hd, #hero .lead, .cta p, #offline .lead').forEach(e => {
        const r = (e as HTMLElement).getBoundingClientRect();
        TR.push([r.left - 30, r.right + 30, r.top + scrollY - 24, r.bottom + scrollY + 24]);
      });
    }

    (function initEcosystem() {
      let id = 0;
      const initialH = innerHeight || 800;
      const waterHorizon = 0.58 * initialH;

      // Species 1: Silvery Schooling Fish (Anchovies) — 12 individuals
      for (let i = 0; i < (small ? 7 : 12); i++) {
        CREATURES.push({
          id: id++, type: 'school',
          x: Math.random() * (innerWidth || 800),
          y: waterHorizon + 40 + Math.random() * 120,
          vx: (Math.random() > 0.5 ? 1 : -1) * (40 + Math.random() * 25),
          vy: 0, targetY: waterHorizon + 70, targetX: 0,
          baseSpeed: 45, dir: 1, length: 28, height: 9,
          phase: Math.random() * 6, z: 0.85,
          ang: 0, vis: 1, minScroll: 0, panicTimer: 0,
          jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
        });
      }

      // Species 2: Tropical Tang / Angelfish — 6 individuals
      for (let i = 0; i < (small ? 3 : 6); i++) {
        CREATURES.push({
          id: id++, type: 'tropical',
          x: Math.random() * (innerWidth || 800),
          y: waterHorizon + 90 + Math.random() * 150,
          vx: (i % 2 === 0 ? 1 : -1) * (26 + Math.random() * 16),
          vy: 0, targetY: waterHorizon + 120, targetX: 0,
          baseSpeed: 28, dir: i % 2 === 0 ? 1 : -1, length: 48, height: 38,
          phase: Math.random() * 6, z: 0.75,
          ang: 0, vis: 1, minScroll: 0, panicTimer: 0,
          jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
        });
      }

      // Species 3: Pelagic Tuna / Hunter Fish — 4 individuals
      for (let i = 0; i < (small ? 2 : 4); i++) {
        CREATURES.push({
          id: id++, type: 'tuna',
          x: Math.random() * (innerWidth || 800),
          y: waterHorizon + 140 + Math.random() * 160,
          vx: (i % 2 === 0 ? 1 : -1) * (55 + Math.random() * 30),
          vy: 0, targetY: waterHorizon + 180, targetX: 0,
          baseSpeed: 60, dir: i % 2 === 0 ? 1 : -1, length: 80, height: 24,
          phase: Math.random() * 6, z: 0.80,
          ang: 0, vis: 1, minScroll: 0.08, panicTimer: 0,
          jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
        });
      }

      // Species 4: Blacktip Reef Shark — 2 sharks
      for (let i = 0; i < 2; i++) {
        CREATURES.push({
          id: id++, type: 'shark',
          x: i === 0 ? -120 : (innerWidth || 800) + 120,
          y: waterHorizon + 180 + i * 80,
          vx: i === 0 ? 38 : -38, vy: 0,
          targetY: waterHorizon + 220, targetX: 0,
          baseSpeed: 40, dir: i === 0 ? 1 : -1, length: 170, height: 44,
          phase: i * 3, z: 0.90,
          ang: 0, vis: 1, minScroll: 0.15, panicTimer: 0,
          jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
        });
      }

      // Species 5: Giant Manta Ray — 1 majestic glider
      CREATURES.push({
        id: id++, type: 'manta',
        x: (innerWidth || 800) * 0.25,
        y: waterHorizon + 240,
        vx: 24, vy: 0,
        targetY: waterHorizon + 260, targetX: 0,
        baseSpeed: 25, dir: 1, length: 180, height: 220,
        phase: 0, z: 0.92,
        ang: 0, vis: 1, minScroll: 0.22, panicTimer: 0,
        jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
      });

      // Species 6: Colossal Blue Whale — 1 giant in the deep
      CREATURES.push({
        id: id++, type: 'whale',
        x: -300,
        y: waterHorizon + 280,
        vx: 16, vy: 0,
        targetY: waterHorizon + 300, targetX: 0,
        baseSpeed: 18, dir: 1, length: 340, height: 95,
        phase: 2, z: 0.60,
        ang: 0, vis: 1, minScroll: 0.32, panicTimer: 0,
        jumping: false, jumpVx: 0, jumpVy: 0, splashTimer: 0, splashX: 0, splashY: 0,
      });
    })();

    mr();
    addEventListener('resize', mr);
    addEventListener('load', mr);
    setTimeout(mr, 1200);

    // ──────────────────────────────────────────────────────────────────────────
    // 7. INTERACTION: CURSOR RIPPLES, WAKE & FORGIVING FISH CLICK
    // ──────────────────────────────────────────────────────────────────────────
    let lastMx = -1, lastMy = -1;
    const wakeTrail: { nx: number; ny: number; t: number }[] = [];

    function creatureAtPoint(cx: number, cy: number): MarineCreature | null {
      for (const c of CREATURES) {
        if (c.vis < 0.1) continue;
        const hitR = Math.max(c.length * 0.8, 65);
        const dx = cx - c.x, dy = cy - c.y;
        if (dx * dx + dy * dy < hitR * hitR) return c;
      }
      return null;
    }

    function onPointerMove(e: PointerEvent) {
      const nx = e.clientX / W;
      const ny = e.clientY / H;
      const curS = curve(P);
      const hzy = (1 - (0.40 + curS * 0.75)) * H;
      const surfaceNY = hzy / H;

      // Surface water ripples
      if (Math.abs(ny - surfaceNY) < 0.22) {
        const speed = lastMx >= 0 ? Math.sqrt((nx - lastMx)**2 + (ny - lastMy)**2) * 60 : 0;
        const str = 1.0 + Math.min(speed * 3.0, 3.5);
        addRipple(nx, ny, str);
        if (speed > 0.003) wakeTrail.push({ nx, ny, t });
      }
      lastMx = nx; lastMy = ny;

      // Cursor underwater turbulence: creatures actively flee when approached
      CREATURES.forEach(c => {
        if (c.jumping) return;
        const dx = c.x - e.clientX;
        const dy = c.y - e.clientY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const avoidR = c.type === 'whale' ? 120 : c.type === 'shark' || c.type === 'manta' ? 160 : 130;
        if (dist < avoidR && dist > 1) {
          const force = (avoidR - dist) / avoidR;
          c.vx += (dx / dist) * force * 55;
          c.vy += (dy / dist) * force * 40;
        }
      });

      // Pointer cursor hover feedback
      const hovered = creatureAtPoint(e.clientX, e.clientY);
      document.body.style.cursor = hovered ? 'pointer' : '';
    }

    function onPointerDown(e: PointerEvent) {
      const nx = e.clientX / W;
      const ny = e.clientY / H;
      addRipple(nx, ny, 3.8);

      const target = creatureAtPoint(e.clientX, e.clientY);
      if (!target || target.jumping) return;

      const curS = curve(P);
      const hzy = (1 - (0.40 + curS * 0.75)) * H;
      const depthFromSurface = target.y - hzy;

      // Surface Breach Jump: any fish in the upper water column (within 260px) leaps!
      if (depthFromSurface < 260 && target.type !== 'whale') {
        target.jumping = true;
        const dir = Math.sign(target.vx) || 1;
        target.jumpVx = dir * (70 + Math.random() * 40);
        target.jumpVy = -(320 + Math.random() * 80); // High parabolic leap out of water!
        target.splashX = target.x;
        target.splashY = hzy;
        target.splashTimer = 0.001;
        addRipple(target.x / W, hzy / H, 4.5);
      } else {
        // Deep Underwater Panic Burst!
        target.panicTimer = 1.6;
        const escapeDir = Math.sign(target.vx) || 1;
        target.vx = escapeDir * target.baseSpeed * 3.5;
        target.vy = (Math.random() - 0.5) * 60;
        // Release explosive bubble burst
        for (let b = 0; b < 8; b++) {
          BUBBLES.push({
            x: target.x - escapeDir * 25 + (Math.random() - 0.5) * 20,
            y: target.y + (Math.random() - 0.5) * 15,
            r: 3 + Math.random() * 4,
            vy: 55 + Math.random() * 50,
            wobbleSpeed: 3 + Math.random() * 3,
            phase: Math.random() * Math.PI * 2,
          });
        }
      }
    }

    addEventListener('pointermove', onPointerMove, { passive: true });
    addEventListener('pointerdown', onPointerDown, { passive: true });

    // ──────────────────────────────────────────────────────────────────────────
    // 8. CREATURE UPDATE & DRAWING ENGINE
    // ──────────────────────────────────────────────────────────────────────────
    function updCreatures(S: number, _D: number) {
      const dt = reduce ? 0 : 0.016;
      const hzy = (1 - (0.40 + S * 0.75)) * H;
      const waterSurface = hzy + Math.max(16, H * 0.025);

      CREATURES.forEach(c => {
        // Jumping creature physics
        if (c.jumping) {
          c.jumpVy += 550 * dt; // gravity
          c.x += c.jumpVx * dt;
          c.y += c.jumpVy * dt;
          c.ang = Math.atan2(c.jumpVy, Math.abs(c.jumpVx));
          c.splashTimer += dt;

          // Re-entry into ocean
          if (c.y >= waterSurface && c.splashTimer > 0.18) {
            c.jumping = false;
            c.vy = 0;
            c.vx = (Math.sign(c.jumpVx) || 1) * c.baseSpeed;
            c.splashTimer = 0.001;
            c.splashX = c.x;
            c.splashY = waterSurface;
            addRipple(c.x / W, waterSurface / H, 4.0);
          }
          return;
        }

        // Panic decay
        if (c.panicTimer > 0) {
          c.panicTimer -= dt;
          if (c.panicTimer <= 0) c.panicTimer = 0;
        }

        const targetSpeed = c.panicTimer > 0 ? c.baseSpeed * 2.8 : c.baseSpeed;
        const curDir = Math.sign(c.vx) || 1;

        // Tail oscillation frequency
        c.phase += dt * (c.panicTimer > 0 ? 14 : 4 + Math.abs(c.vx) * 0.08);

        // Horizontal movement & screen wrapping
        c.x += c.vx * dt;
        if (curDir > 0 && c.x > W + c.length + 100) c.x = -c.length - 100;
        else if (curDir < 0 && c.x < -c.length - 100) c.x = W + c.length + 100;

        // Never cross into sky when not jumping
        if (c.y < waterSurface + 15) {
          c.y = waterSurface + 15;
          if (c.vy < 0) c.vy = 0;
        }
        if (c.y > H - 30) c.y = H - 40;

        // Vertical cruising sway
        const depthBias = c.type === 'whale' ? 0.82 : c.type === 'manta' ? 0.70 : c.type === 'shark' ? 0.55 : c.type === 'tuna' ? 0.42 : 0.25;
        const idealY = waterSurface + (H - waterSurface) * depthBias + Math.sin(t * 0.7 + c.id) * 30;
        c.vy += (idealY - c.y) * 0.05;
        c.y += c.vy * dt;

        // Speed regulation
        const targetVx = curDir * targetSpeed;
        c.vx += (targetVx - c.vx) * (1 - Math.exp(-dt * 2));
        c.ang += (Math.atan2(c.vy, Math.abs(c.vx) + 1) - c.ang) * 0.08;

        // Text avoidance
        let textAvoid = 1;
        const currentScrollY = c.y + scrollY;
        for (let i = 0; i < TR.length; i++) {
          const r = TR[i];
          if (c.x > r[0] && c.x < r[1] && currentScrollY > r[2] && currentScrollY < r[3]) {
            textAvoid = 0.2;
            break;
          }
        }

        // Progressive depth appearance
        const scrollVis = P >= c.minScroll ? 1 : Math.max(0.2, 1 - (c.minScroll - P) * 3);
        c.vis += (scrollVis * textAvoid - c.vis) * 0.06;
      });
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 9. PROCEDURAL RENDERING OF EACH MARINE SPECIES
    // ──────────────────────────────────────────────────────────────────────────
    function drawCreatures(_S: number, D: number, _uw: number) {
      const depthDim = 1 - 0.35 * D;

      CREATURES.forEach(c => {
        if (c.vis < 0.02 && !c.jumping) return;
        const a = c.jumping ? 1 : Math.min(1, c.vis) * depthDim;
        const facing = (c.jumping ? c.jumpVx : c.vx) < 0 ? -1 : 1;

        fcx.save();
        fcx.translate(c.x, c.y);
        fcx.scale(facing, 1);
        fcx.rotate(c.ang);

        if (c.type === 'school') {
          // --- SPECIES 1: SILVERY ANCHOVY / SCHOOLING FISH ---
          const L = c.length, Hf = c.height;
          const wag = Math.sin(c.phase) * 5;
          fcx.fillStyle = `rgba(180, 240, 245, ${a * 0.95})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.5, 0);
          fcx.quadraticCurveTo(0, -Hf * 0.7, -L * 0.4, -Hf * 0.2);
          fcx.lineTo(-L * 0.5 + wag, -Hf * 0.6);
          fcx.lineTo(-L * 0.45 + wag * 0.5, 0);
          fcx.lineTo(-L * 0.5 + wag, Hf * 0.6);
          fcx.lineTo(-L * 0.4, Hf * 0.2);
          fcx.quadraticCurveTo(0, Hf * 0.7, L * 0.5, 0);
          fcx.fill();
          fcx.strokeStyle = `rgba(255, 255, 255, ${a * 0.8})`;
          fcx.lineWidth = 1.2;
          fcx.beginPath();
          fcx.moveTo(L * 0.35, 0);
          fcx.lineTo(-L * 0.3, 0);
          fcx.stroke();
        } else if (c.type === 'tropical') {
          // --- SPECIES 2: TROPICAL TANG / ANGEL FISH ---
          const L = c.length, Hf = c.height;
          const tailWag = Math.sin(c.phase) * 6;
          // Body
          fcx.fillStyle = `rgba(0, 206, 201, ${a * 0.95})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.5, 0);
          fcx.quadraticCurveTo(L * 0.1, -Hf * 0.65, -L * 0.2, -Hf * 0.3);
          fcx.lineTo(-L * 0.4 + tailWag, -Hf * 0.4);
          fcx.lineTo(-L * 0.4 + tailWag, Hf * 0.4);
          fcx.lineTo(-L * 0.2, Hf * 0.3);
          fcx.quadraticCurveTo(L * 0.1, Hf * 0.65, L * 0.5, 0);
          fcx.fill();
          // Vibrant dorsal sail
          fcx.fillStyle = `rgba(253, 203, 110, ${a * 0.95})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.15, -Hf * 0.55);
          fcx.quadraticCurveTo(-L * 0.05, -Hf * 1.05, -L * 0.28, -Hf * 0.3);
          fcx.fill();
          // Belly sail
          fcx.beginPath();
          fcx.moveTo(L * 0.1, Hf * 0.55);
          fcx.quadraticCurveTo(-L * 0.05, Hf * 0.95, -L * 0.25, Hf * 0.3);
          fcx.fill();
          // Stripes
          fcx.strokeStyle = `rgba(255, 234, 167, ${a * 0.95})`;
          fcx.lineWidth = 3;
          fcx.beginPath();
          fcx.moveTo(L * 0.2, -Hf * 0.35);
          fcx.lineTo(L * 0.05, Hf * 0.35);
          fcx.stroke();
        } else if (c.type === 'tuna') {
          // --- SPECIES 3: PELAGIC TUNA ---
          const L = c.length, Hf = c.height;
          const tailWag = Math.sin(c.phase) * 7;
          fcx.fillStyle = `rgba(24, 75, 105, ${a * 0.95})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.5, 0);
          fcx.quadraticCurveTo(L * 0.1, -Hf * 0.6, -L * 0.35, -Hf * 0.15);
          fcx.lineTo(-L * 0.45 + tailWag, 0);
          fcx.lineTo(-L * 0.35, Hf * 0.15);
          fcx.quadraticCurveTo(L * 0.1, Hf * 0.6, L * 0.5, 0);
          fcx.fill();
          // Golden yellow sickle caudal fin
          fcx.fillStyle = `rgba(241, 196, 15, ${a * 0.9})`;
          fcx.beginPath();
          fcx.moveTo(-L * 0.45 + tailWag, 0);
          fcx.lineTo(-L * 0.65 + tailWag, -Hf * 0.85);
          fcx.lineTo(-L * 0.52 + tailWag, 0);
          fcx.lineTo(-L * 0.65 + tailWag, Hf * 0.85);
          fcx.fill();
          // Shimmer flank
          fcx.fillStyle = `rgba(220, 245, 255, ${a * 0.5})`;
          fcx.beginPath();
          fcx.ellipse(0, Hf * 0.1, L * 0.3, Hf * 0.25, 0, 0, Math.PI * 2);
          fcx.fill();
        } else if (c.type === 'shark') {
          // --- SPECIES 4: BLACKTIP REEF SHARK ---
          const L = c.length, Hf = c.height;
          const s1 = Math.sin(c.phase) * 8;
          const s2 = Math.sin(c.phase - 1.2) * 15;
          fcx.fillStyle = `rgba(28, 55, 75, ${a * 0.96})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.5, 0);
          fcx.quadraticCurveTo(L * 0.2, -Hf * 0.45, -L * 0.1, -Hf * 0.35);
          fcx.quadraticCurveTo(-L * 0.3 + s1, -Hf * 0.18, -L * 0.5 + s2, 0);
          fcx.lineTo(-L * 0.70 + s2, -Hf * 0.95); // Tall upper caudal lobe
          fcx.lineTo(-L * 0.55 + s2, -Hf * 0.1);
          fcx.lineTo(-L * 0.64 + s2, Hf * 0.45); // Lower caudal lobe
          fcx.lineTo(-L * 0.45 + s1, Hf * 0.1);
          fcx.quadraticCurveTo(-L * 0.1, Hf * 0.35, L * 0.2, Hf * 0.35);
          fcx.quadraticCurveTo(L * 0.38, Hf * 0.2, L * 0.5, 0);
          fcx.fill();
          // Iconic tall triangular dorsal fin
          fcx.fillStyle = `rgba(20, 42, 58, ${a * 0.98})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.08, -Hf * 0.42);
          fcx.lineTo(-L * 0.05, -Hf * 1.25);
          fcx.quadraticCurveTo(-L * 0.02, -Hf * 0.5, -L * 0.12, -Hf * 0.34);
          fcx.fill();
          // Blacktip mark on dorsal
          fcx.fillStyle = `rgba(0, 0, 0, ${a * 0.95})`;
          fcx.beginPath();
          fcx.arc(-L * 0.05, -Hf * 1.15, 5, 0, Math.PI * 2);
          fcx.fill();
          // Pectoral wing fin
          fcx.beginPath();
          fcx.moveTo(L * 0.18, Hf * 0.1);
          fcx.lineTo(L * 0.02, Hf * 0.85);
          fcx.lineTo(L * 0.08, Hf * 0.1);
          fcx.fill();
          // 5 gill slits
          fcx.strokeStyle = `rgba(180, 210, 230, ${a * 0.5})`;
          fcx.lineWidth = 1.2;
          for (let g = 0; g < 5; g++) {
            fcx.beginPath();
            fcx.moveTo(L * (0.24 - g * 0.02), -Hf * 0.15);
            fcx.lineTo(L * (0.23 - g * 0.02), Hf * 0.15);
            fcx.stroke();
          }
        } else if (c.type === 'manta') {
          // --- SPECIES 5: GIANT MANTA RAY ---
          const L = c.length, Wf = c.height;
          const wingFlap = Math.sin(c.phase) * (Wf * 0.25);
          fcx.fillStyle = `rgba(18, 38, 54, ${a * 0.96})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.4, 0);
          fcx.bezierCurveTo(L * 0.2, -Wf * 0.5 + wingFlap, -L * 0.1, -Wf * 0.65 + wingFlap, -L * 0.3, -Wf * 0.05);
          fcx.lineTo(-L * 0.5, 0);
          fcx.bezierCurveTo(-L * 0.1, Wf * 0.65 - wingFlap, L * 0.2, Wf * 0.5 - wingFlap, L * 0.4, 0);
          fcx.fill();
          // Long whip tail
          fcx.strokeStyle = `rgba(14, 30, 44, ${a * 0.9})`;
          fcx.lineWidth = 2.5;
          fcx.beginPath();
          fcx.moveTo(-L * 0.5, 0);
          fcx.quadraticCurveTo(-L * 0.75, Math.sin(c.phase) * 10, -L * 0.98, 0);
          fcx.stroke();
          // Luminous cyan shoulder patch
          fcx.fillStyle = `rgba(57, 216, 208, ${a * 0.5})`;
          fcx.beginPath();
          fcx.ellipse(0, 0, L * 0.2, Wf * 0.14, 0, 0, Math.PI * 2);
          fcx.fill();
        } else if (c.type === 'whale') {
          // --- SPECIES 6: COLOSSAL BLUE WHALE ---
          const L = c.length, Hf = c.height;
          const flukeWag = Math.sin(c.phase) * 20;
          fcx.fillStyle = `rgba(12, 30, 44, ${a * 0.9})`;
          fcx.beginPath();
          fcx.moveTo(L * 0.5, -Hf * 0.1);
          fcx.quadraticCurveTo(L * 0.2, -Hf * 0.6, -L * 0.2, -Hf * 0.4);
          fcx.quadraticCurveTo(-L * 0.45, -Hf * 0.2, -L * 0.5 + flukeWag * 0.3, 0);
          fcx.lineTo(-L * 0.62 + flukeWag, -Hf * 0.75);
          fcx.quadraticCurveTo(-L * 0.56 + flukeWag, 0, -L * 0.62 + flukeWag, Hf * 0.75);
          fcx.lineTo(-L * 0.5 + flukeWag * 0.3, 0);
          fcx.quadraticCurveTo(-L * 0.2, Hf * 0.5, L * 0.2, Hf * 0.5);
          fcx.quadraticCurveTo(L * 0.45, Hf * 0.3, L * 0.5, -Hf * 0.1);
          fcx.fill();
          // Faint belly pleats
          fcx.strokeStyle = `rgba(80, 160, 190, ${a * 0.3})`;
          fcx.lineWidth = 1.5;
          for (let p = 0; p < 4; p++) {
            fcx.beginPath();
            fcx.moveTo(L * 0.35, Hf * (0.1 + p * 0.08));
            fcx.lineTo(L * 0.05, Hf * (0.2 + p * 0.08));
            fcx.stroke();
          }
        }

        fcx.restore();
      });

      // Draw splash particles from jumping fish
      CREATURES.forEach(c => {
        if (c.splashTimer > 0 && c.splashTimer < 0.7) {
          const progress = c.splashTimer / 0.7;
          const sx = c.splashX, sy = c.splashY;
          fcx.save();
          fcx.globalAlpha = (1 - progress) * 0.9;

          // Droplet spray
          const count = 16;
          fcx.fillStyle = 'rgba(225, 252, 255, 0.95)';
          for (let i = 0; i < count; i++) {
            const angle = Math.PI + (i / (count - 1)) * Math.PI;
            const spd = 40 + (i % 4) * 22;
            const px = sx + Math.cos(angle) * (progress * spd * 1.6);
            const py = sy + Math.sin(angle) * (progress * spd) + progress * progress * 50;
            fcx.beginPath();
            fcx.arc(px, py, (1 - progress) * 3.5 + 1.2, 0, Math.PI * 2);
            fcx.fill();
          }

          // Concentric impact ripples
          fcx.strokeStyle = 'rgba(184, 245, 239, 0.85)';
          fcx.lineWidth = 2.2;
          fcx.beginPath();
          fcx.ellipse(sx, sy, progress * 80, progress * 18, 0, 0, Math.PI * 2);
          fcx.stroke();
          fcx.restore();
          c.splashTimer += 0.016;
          if (c.splashTimer >= 0.7) c.splashTimer = 0;
        }
      });
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 10. DRAWING TERRAIN: BOULDERS, VIBRANT CORALS & SWAYING KELP
    // ──────────────────────────────────────────────────────────────────────────
    function drawTerrain(S: number, D: number, uw: number) {
      const hzy = (1 - (0.40 + S * 0.75)) * H;
      const seabedY = H; // Sea bottom rests at bottom of screen
      const alpha = Math.max(0.65, Math.min(1, 0.65 + uw * 0.35));

      // --- LAYER 1: ROCKS & BOULDERS ---
      ROCKS.forEach(r => {
        const rx = r.cx * W;
        const ry = seabedY;
        const rockAlpha = alpha * (r.layer === 0 ? 0.5 : r.layer === 1 ? 0.8 : 1.0);

        fcx.save();
        fcx.globalAlpha = rockAlpha;
        const grad = fcx.createLinearGradient(rx, ry - r.h, rx, ry);
        grad.addColorStop(0, r.colorLight);
        grad.addColorStop(1, r.colorDark);
        fcx.fillStyle = grad;

        fcx.beginPath();
        fcx.moveTo(rx + r.pts[0][0], ry + r.pts[0][1]);
        for (let i = 1; i < r.pts.length; i++) {
          fcx.lineTo(rx + r.pts[i][0], ry + r.pts[i][1]);
        }
        fcx.lineTo(rx + r.w * 0.5, ry + 20);
        fcx.lineTo(rx - r.w * 0.5, ry + 20);
        fcx.closePath();
        fcx.fill();

        // Rim highlight on rocks
        fcx.strokeStyle = `rgba(140, 235, 245, ${rockAlpha * 0.5})`;
        fcx.lineWidth = 2.0;
        fcx.beginPath();
        fcx.moveTo(rx + r.pts[0][0], ry + r.pts[0][1]);
        for (let i = 1; i < r.pts.length - 1; i++) {
          fcx.lineTo(rx + r.pts[i][0], ry + r.pts[i][1]);
        }
        fcx.stroke();
        fcx.restore();
      });

      // --- LAYER 2: VIBRANT CORAL REEFS ---
      CORALS.forEach(c => {
        const cx = c.xFrac * W;
        const cy = seabedY - c.yOffset;
        const sc = c.scale * (small ? 0.8 : 1);

        fcx.save();
        fcx.globalAlpha = alpha;

        if (c.type === 'staghorn') {
          // Branching Staghorn Coral
          fcx.strokeStyle = c.color;
          fcx.lineWidth = 6 * sc;
          fcx.lineCap = 'round';
          fcx.beginPath();
          fcx.moveTo(cx, cy);
          fcx.lineTo(cx, cy - 45 * sc);
          // Left branches
          fcx.moveTo(cx, cy - 22 * sc);
          fcx.lineTo(cx - 25 * sc, cy - 52 * sc);
          fcx.lineTo(cx - 30 * sc, cy - 75 * sc);
          // Right branches
          fcx.moveTo(cx, cy - 30 * sc);
          fcx.lineTo(cx + 22 * sc, cy - 58 * sc);
          fcx.lineTo(cx + 28 * sc, cy - 82 * sc);
          fcx.stroke();

          // Glowing polyps at branch tips
          fcx.fillStyle = c.accentColor;
          [[-30, -75], [0, -45], [28, -82]].forEach(([ox, oy]) => {
            fcx.beginPath();
            fcx.arc(cx + ox * sc, cy + oy * sc, 5.5 * sc, 0, Math.PI * 2);
            fcx.fill();
          });
        } else if (c.type === 'shelf') {
          // Tiered Table / Shelf Coral
          fcx.fillStyle = c.color;
          for (let s = 0; s < 3; s++) {
            const shelfY = cy - s * 22 * sc;
            const shelfW = (55 - s * 10) * sc;
            fcx.beginPath();
            fcx.ellipse(cx, shelfY, shelfW, 9 * sc, 0, 0, Math.PI * 2);
            fcx.fill();
            fcx.strokeStyle = c.accentColor;
            fcx.lineWidth = 2.0;
            fcx.stroke();
          }
        } else if (c.type === 'brain') {
          // Rounded Brain Coral
          fcx.fillStyle = c.color;
          fcx.beginPath();
          fcx.arc(cx, cy, 35 * sc, Math.PI, 0);
          fcx.fill();
          fcx.strokeStyle = c.accentColor;
          fcx.lineWidth = 2.2;
          for (let r = 0; r < 4; r++) {
            fcx.beginPath();
            fcx.arc(cx, cy, (8 + r * 7) * sc, Math.PI + 0.2, -0.2);
            fcx.stroke();
          }
        }
        fcx.restore();
      });

      // --- LAYER 3: SWAYING GIANT KELP FORESTS ---
      KELP.forEach(k => {
        const kx = k.xFrac * W;
        const ky = seabedY;
        const steps = 8;
        const stepH = k.height / steps;

        fcx.save();
        fcx.globalAlpha = alpha * 0.85;
        fcx.strokeStyle = k.color;
        fcx.lineWidth = k.bladeWidth;
        fcx.lineCap = 'round';

        fcx.beginPath();
        fcx.moveTo(kx, ky);

        let curX = kx;
        let curY = ky;
        for (let s = 1; s <= steps; s++) {
          const sway = Math.sin(t * k.speed + k.phase + s * 0.35) * (s * 5.5);
          const nxtX = kx + sway;
          const nxtY = ky - s * stepH;
          fcx.quadraticCurveTo(curX, (curY + nxtY) * 0.5, nxtX, nxtY);
          curX = nxtX;
          curY = nxtY;
        }
        fcx.stroke();
        fcx.restore();
      });

      // --- LAYER 4: RISING AIR BUBBLES ---
      BUBBLES.forEach(b => {
        b.y -= b.vy * 0.016;
        b.phase += 0.016 * b.wobbleSpeed;
        const bx = b.x + Math.sin(b.phase) * 7;

        if (b.y < hzy + 10) {
          b.y = seabedY + Math.random() * 60;
          b.x = Math.random() * W;
        }

        fcx.save();
        fcx.globalAlpha = alpha * 0.75;
        fcx.fillStyle = 'rgba(215, 252, 255, 0.45)';
        fcx.beginPath();
        fcx.arc(bx, b.y, b.r, 0, Math.PI * 2);
        fcx.fill();
        // Specular glint
        fcx.fillStyle = 'rgba(255, 255, 255, 0.9)';
        fcx.beginPath();
        fcx.arc(bx - b.r * 0.35, b.y - b.r * 0.35, b.r * 0.35, 0, Math.PI * 2);
        fcx.fill();
        fcx.restore();
      });

      // --- LAYER 5: DRIFTING MARINE SNOW ---
      const pv = (Math.max(0, Math.min(1, (S - 0.15) / 0.5)) * 0.6 + uw * 0.4) * (1 + D * 0.4);
      if (pv > 0.05) {
        for (let j = 0; j < MS.length; j++) {
          const m = MS[j];
          const px = m.x * W + Math.sin(t * 0.5 + m.p) * 18;
          const py = (((m.y * H - t * 9 * m.s - sy * 0.3) % H) + H) % H;
          fcx.fillStyle = `rgba(220, 245, 245, ${0.25 * pv * (0.5 + 0.5 * Math.sin(t + m.p))})`;
          fcx.beginPath();
          fcx.arc(px, py, m.r, 0, Math.PI * 2);
          fcx.fill();
        }
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 11. DRAWING WATER SURFACE RIPPLES & TEXT REFLECTION
    // ──────────────────────────────────────────────────────────────────────────
    function drawSurfaceEffects(S: number, uw: number) {
      const hzy = (1 - (0.40 + S * 0.75)) * H;
      rcx.clearRect(0, 0, W, H);
      if (reduce) return;

      const surfaceY = hzy;
      const alpha = Math.max(0, 1 - uw * 1.5) * 0.45;
      if (alpha < 0.005) return;

      const cellW = W / GRID_COLS;
      const cellH = Math.min(80, H * 0.1) / Math.max(GRID_ROWS * 0.3, 1);

      // Ripple field
      for (let x = 0; x < GRID_COLS; x++) {
        const mid = Math.floor(GRID_ROWS * 0.4);
        for (let y = mid - 4; y < mid + 4; y++) {
          if (y < 0 || y >= GRID_ROWS) continue;
          const v = ripBuf0[y * GRID_COLS + x];
          if (Math.abs(v) < 0.01) continue;
          const px = x * cellW;
          const py = surfaceY + (y - mid) * cellH + v * 8;
          const bright = Math.min(1, Math.abs(v) * 2.5);
          rcx.fillStyle = `rgba(180, 248, 245, ${bright * alpha})`;
          rcx.fillRect(px, py, cellW + 1, 2.5);
        }
      }

      // Shimmer wave horizon line
      rcx.save();
      rcx.globalAlpha = alpha * 0.7;
      rcx.strokeStyle = 'rgba(215, 252, 250, 0.85)';
      rcx.lineWidth = 2.0;
      rcx.beginPath();
      for (let x = 0; x < GRID_COLS; x++) {
        const mid = Math.floor(GRID_ROWS * 0.4);
        const v = ripBuf0[mid * GRID_COLS + x];
        const px = x * cellW;
        const py = surfaceY + v * 9;
        if (x === 0) rcx.moveTo(px, py); else rcx.lineTo(px, py);
      }
      rcx.stroke();
      rcx.restore();

      // Mirrored Text Reflection of "AQUANET X"
      if (P < 0.08) {
        const reflAlpha = (1 - P / 0.08) * 0.25;
        rcx.save();
        rcx.font = "700 clamp(32px, 5.5vw, 60px) 'Outfit', sans-serif";
        rcx.textAlign = 'center';
        rcx.textBaseline = 'top';
        const brandText = "AQUANET X";
        const textY = surfaceY + 6;
        const slices = 9;
        for (let s = 0; s < slices; s++) {
          const sliceY = textY + s * 4.5;
          const sampleX = Math.floor(GRID_COLS * 0.5);
          const sampleY = Math.floor(GRID_ROWS * 0.4);
          const ripVal = ripBuf0[sampleY * GRID_COLS + sampleX] || 0;
          const waveDisplace = Math.sin(t * 1.8 + s * 0.9) * (2 + s * 0.8) + ripVal * 12;
          rcx.fillStyle = `rgba(184, 245, 239, ${reflAlpha * (1 - s / slices) * 0.8})`;
          rcx.fillText(brandText, W * 0.5 + waveDisplace, sliceY);
        }
        rcx.restore();
      }

      // Fading wake trail
      for (let i = wakeTrail.length - 1; i >= 0; i--) {
        const p = wakeTrail[i];
        const age = t - p.t;
        if (age > 1.2) {
          wakeTrail.splice(i, 1);
          continue;
        }
        const fade = (1 - age / 1.2) * alpha * 0.6;
        const wx = p.nx * W;
        const wy = p.ny * H;
        rcx.fillStyle = `rgba(180, 245, 240, ${fade})`;
        rcx.beginPath();
        rcx.arc(wx, wy, 2.0 + age * 8, 0, Math.PI * 2);
        rcx.fill();
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 12. MAIN ANIMATION LOOP
    // ──────────────────────────────────────────────────────────────────────────
    function frame() {
      t += reduce ? 0 : 0.016;
      sy += (scrollY - sy) * (reduce ? 1 : 0.1);
      const mx = Math.max(1, document.documentElement.scrollHeight - H);
      P = Math.min(1, Math.max(0, sy / mx));
      const S  = curve(P);
      const Dd = interp(DP, P);
      const dk = Math.min(1, Math.max(0, (sy - H * 0.12) / (H * 0.6)));
      const uw = Math.min(1, Math.max(0, (S - 0.38) / 0.54));

      // 1. WebGL Ocean Background
      if (gl) {
        gl.uniform2f(U['R'], cv.width, cv.height);
        gl.uniform1f(U['T'], t);
        gl.uniform1f(U['S'], S);
        gl.uniform1f(U['K'], P);
        gl.uniform1f(U['Dk'], dk * (1 - boost));
        gl.uniform1f(U['B'], boost);
        gl.uniform1f(U['D'], Dd);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      }

      // 2. Physics & Fluid calculations
      stepRipple();
      updCreatures(S, Dd);

      // 3. Render layers in order: Terrain & Corals -> Creatures -> Water Surface
      fcx.clearRect(0, 0, W, H);
      drawTerrain(S, Dd, uw);
      drawCreatures(S, Dd, uw);
      drawSurfaceEffects(S, uw);

      document.body.style.setProperty('--dp', Dd.toFixed(3));
      document.body.classList.toggle('sky', dk < 0.3);
      animId = requestAnimationFrame(frame);
    }
    animId = requestAnimationFrame(frame);

    // ──────────────────────────────────────────────────────────────────────────
    // 13. SCROLL METRICS & NAVIGATION INTEGRATION
    // ──────────────────────────────────────────────────────────────────────────
    const nav         = navRef.current;
    const bar         = barRef.current;
    const rail        = railRef.current;
    const steps       = stepsRef.current;
    const heroContent = heroContentRef.current;
    const stepEls     = Array.from(document.querySelectorAll('.step'));

    function onS() {
      const mxs = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const p = Math.min(1, scrollY / mxs);
      nav?.classList.toggle('s', scrollY > 40);
      if (bar)  bar.style.transform = `scaleX(${p})`;
      if (rail) rail.style.setProperty('--P', String(p));
      if (dpRef.current) dpRef.current.textContent = `${Math.round(p * 40)} m`;
      const hf = Math.max(0, 1 - scrollY / (innerHeight * 0.45));
      if (heroContent) {
        heroContent.style.opacity = String(hf);
        heroContent.style.visibility = hf <= 0 ? 'hidden' : 'visible';
      }
      if (steps) {
        const r  = steps.getBoundingClientRect();
        const pr = Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / (r.height + innerHeight * 0.05)));
        steps.style.setProperty('--pr', String(pr));
        stepEls.forEach((s, i) => s.classList.toggle('on', pr >= i / 3.4));
      }
    }
    addEventListener('scroll', onS, { passive: true });
    addEventListener('resize', onS);
    onS();

    // Intersection observer for glass reveal
    const io = new IntersectionObserver(es => {
      es.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          if (e.target.classList.contains('rv')) setTimeout(() => e.target.classList.add('done'), 1500);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.rv, .hd, .fade').forEach(e => {
      if (e.id !== 'h1' && !e.closest('#hero')) io.observe(e);
    });
    setTimeout(() => {
      document.querySelectorAll('#hero .hd, #hero .fade').forEach(e => e.classList.add('in'));
    }, 200);

    // Pointer lighting for glassmorphic elements
    const glassEls = document.querySelectorAll('.glass');
    const pointerHandlers: { el: Element; move: (e: Event) => void; leave: (e: Event) => void }[] = [];
    glassEls.forEach(c => {
      const move = (e: Event) => {
        const pe = e as PointerEvent;
        const r = (c as HTMLElement).getBoundingClientRect();
        (c as HTMLElement).style.setProperty('--mx', `${((pe.clientX - r.left) / r.width) * 100}%`);
        (c as HTMLElement).style.setProperty('--my', `${((pe.clientY - r.top) / r.height) * 100}%`);
      };
      const leave = () => {
        (c as HTMLElement).style.setProperty('--rx', '0deg');
        (c as HTMLElement).style.setProperty('--ry', '0deg');
      };
      c.addEventListener('pointermove', move);
      c.addEventListener('pointerleave', leave);
      pointerHandlers.push({ el: c, move, leave });
    });

    return () => {
      cancelAnimationFrame(animId);
      removeEventListener('resize', rs);
      removeEventListener('resize', mr);
      removeEventListener('scroll', onS);
      removeEventListener('load', mr);
      removeEventListener('pointermove', onPointerMove as EventListener);
      removeEventListener('pointerdown', onPointerDown as EventListener);
      io.disconnect();
      pointerHandlers.forEach(({ el, move, leave }) => {
        el.removeEventListener('pointermove', move);
        el.removeEventListener('pointerleave', leave);
      });
      document.body.classList.remove('sky');
      document.body.style.removeProperty('--dp');
      document.body.style.cursor = '';
    };
  }, []);

  const toggleMenu = () => menuRef.current?.classList.toggle('o');
  const closeMenu  = () => menuRef.current?.classList.remove('o');

  return (
    <>
      <canvas id="sea"  ref={seaRef}  aria-hidden="true" />
      <canvas id="fish" ref={fishRef} aria-hidden="true" />
      <canvas id="rip"  ref={ripRef}  aria-hidden="true" />
      <div id="bar" ref={barRef} />
      <div className="rail" aria-hidden="true">
        <i />
        <b id="dp" ref={dpRef as React.RefObject<HTMLElement>}>0 m</b>
      </div>

      {/* Navigation */}
      <nav className="glass g-l landing-nav" id="nav" ref={navRef}>
        <a className="logo" href="#top">AQUANET <b>X</b></a>
        <div className="links">
          <a href="#challenge" onClick={closeMenu}>The Challenge</a>
          <a href="#platform"  onClick={closeMenu}>Platform</a>
          <a href="#how"       onClick={closeMenu}>How It Works</a>
          <a href="#offline"   onClick={closeMenu}>About</a>
        </div>
        <div className="nb">
          <button className="btn hide" onClick={handleLogin}>Login</button>
          <button className="btn p"    onClick={handleGetStarted}>Get Started</button>
          <button className="btn burger" id="bg" aria-label="Menu" aria-expanded="false" onClick={toggleMenu}>Menu</button>
        </div>
      </nav>

      {/* Mobile menu */}
      <div className="glass g-d" id="lp-menu" ref={menuRef}>
        <a href="#challenge" onClick={closeMenu}>The Challenge</a>
        <a href="#platform"  onClick={closeMenu}>Platform</a>
        <a href="#how"       onClick={closeMenu}>How It Works</a>
        <a href="#offline"   onClick={closeMenu}>About</a>
        <button className="btn" onClick={() => { closeMenu(); handleLogin(); }}>Login</button>
      </div>

      <main id="top" style={{ position: 'relative', zIndex: 2, isolation: 'isolate' }}>
        {/* Hero */}
        <section id="hero">
          <div ref={heroContentRef}>
            <h1 className="hd" id="h1">
              <span><b>Predict floods.</b></span>
              <span><b>Prevent shortages.</b></span>
              <span><b>Recover every drop.</b></span>
            </h1>
            <p className="lead fade" style={{ transitionDelay: '0.9s' }}>
              An offline-first urban water intelligence and emergency safety platform for cities that need to see water clearly.
            </p>
            <div className="row fade" style={{ transitionDelay: '1.1s' }}>
              <button className="btn p" id="explore" onClick={handleExplore}>Explore AQUANET X</button>
              <button className="btn"   onClick={handleGetStarted}>Get Started</button>
            </div>
          </div>
        </section>

        {/* Challenge section */}
        <section id="challenge">
          <h2 className="hd">
            <span><b>Water moves through a city.</b></span>
            <span><b>Intelligence should too.</b></span>
          </h2>
          <div className="grid g3">
            <div className="glass card rv" style={{ '--i': 0 } as React.CSSProperties}>
              <div className="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="#B8F5EF" strokeWidth="1.8" strokeLinecap="round">
                  <path d="M2 9c3-3 5 3 8 0s5 3 8 0 3 0 4 0M2 15c3-3 5 3 8 0s5 3 8 0 3 0 4 0" />
                </svg>
              </div>
              <h3>Flood Intelligence</h3>
              <p>Understand changing flood conditions and identify areas at risk.</p>
            </div>
            <div className="glass card rv" style={{ '--i': 1 } as React.CSSProperties}>
              <div className="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="#B8F5EF" strokeWidth="1.8" strokeLinecap="round">
                  <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z" />
                </svg>
              </div>
              <h3>Water Intelligence</h3>
              <p>Monitor water availability, weather conditions, and water stress.</p>
            </div>
            <div className="glass card rv" style={{ '--i': 2 } as React.CSSProperties}>
              <div className="ic">
                <svg viewBox="0 0 24 24" fill="none" stroke="#B8F5EF" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
                  <path d="M9 12l2 2 4-4" />
                </svg>
              </div>
              <h3>Emergency Safety</h3>
              <p>Support communities with offline-first emergency information.</p>
            </div>
          </div>
        </section>

        {/* Platform section */}
        <section id="platform">
          <h2 className="hd">
            <span><b>One platform.</b></span>
            <span><b>A clearer view of water.</b></span>
          </h2>
          <div className="grid g2">
            <div className="glass g-d card rv" style={{ '--i': 0 } as React.CSSProperties}>
              <svg viewBox="0 0 300 110">
                <path fill="rgba(102,232,224,.45)" d="M0 60C40 40 70 75 110 55S190 30 220 45 280 20 300 30V110H0z">
                  <animate attributeName="d" dur="5s" repeatCount="indefinite" values="M0 60C40 40 70 75 110 55S190 30 220 45 280 20 300 30V110H0z;M0 45C40 70 70 40 110 60S190 60 220 30 280 45 300 40V110H0z;M0 60C40 40 70 75 110 55S190 30 220 45 280 20 300 30V110H0z" />
                </path>
                <line x1="0" y1="38" x2="300" y2="38" stroke="#B8F5EF" strokeDasharray="4 5" opacity=".7" />
              </svg>
              <h3>Flood Intelligence</h3>
              <p>Rising-water patterns and at-risk zones, surfaced before they become emergencies.</p>
            </div>
            <div className="glass g-d card rv" style={{ '--i': 1 } as React.CSSProperties}>
              <svg viewBox="0 0 300 110">
                <rect x="125" y="6" width="50" height="98" rx="14" fill="none" stroke="#B8F5EF" opacity=".7" />
                <clipPath id="k"><rect x="127" y="8" width="46" height="94" rx="12" /></clipPath>
                <rect clipPath="url(#k)" x="127" y="40" width="46" height="70" fill="#39D8D0" opacity=".65">
                  <animate attributeName="y" values="34;66;34" dur="7s" repeatCount="indefinite" />
                </rect>
                <circle cx="60" cy="55" r="4" fill="#66E8E0">
                  <animate attributeName="r"       values="4;22;4" dur="3s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0;1"  dur="3s" repeatCount="indefinite" />
                </circle>
                <circle cx="240" cy="55" r="4" fill="#66E8E0">
                  <animate attributeName="r"       values="4;22;4" dur="3s" begin="1.5s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="1;0;1"  dur="3s" begin="1.5s" repeatCount="indefinite" />
                </circle>
              </svg>
              <h3>Water Stress</h3>
              <p>See how supply and demand are shifting across neighbourhoods.</p>
            </div>
            <div className="glass g-d card rv" style={{ '--i': 2 } as React.CSSProperties}>
              <svg viewBox="0 0 300 110">
                <g fill="#B8F5EF" opacity=".85">
                  <ellipse cx="130" cy="30" rx="48" ry="17" />
                  <ellipse cx="165" cy="24" rx="34" ry="19" />
                  <ellipse cx="190" cy="34" rx="30" ry="14" />
                </g>
                <g stroke="#66E8E0" strokeWidth="2.5" strokeLinecap="round">
                  <path d="M115 62v10"><animateTransform attributeName="transform" type="translate" values="0 0;-6 36" dur="1.2s" repeatCount="indefinite" /></path>
                  <path d="M150 62v10"><animateTransform attributeName="transform" type="translate" values="0 0;-6 36" dur="1.5s" repeatCount="indefinite" /></path>
                  <path d="M185 62v10"><animateTransform attributeName="transform" type="translate" values="0 0;-6 36" dur="1.3s" repeatCount="indefinite" /></path>
                </g>
              </svg>
              <h3>Weather Intelligence</h3>
              <p>Rain, wind, and storm signals translated into plain, usable guidance.</p>
            </div>
            <div className="glass g-d card rv" style={{ '--i': 3 } as React.CSSProperties}>
              <svg viewBox="0 0 300 110">
                <g fill="none" stroke="#66E8E0" strokeWidth="3" strokeLinecap="round">
                  <path d="M112 62a40 40 0 0 1 66-26" />
                  <path d="M186 44a40 40 0 0 1-8 44" />
                  <path d="M166 98a40 40 0 0 1-54-30" />
                  <animateTransform attributeName="transform" type="rotate" from="0 150 58" to="360 150 58" dur="12s" repeatCount="indefinite" />
                </g>
                <path d="M150 40s14 15 14 25a14 14 0 0 1-28 0c0-10 14-25 14-25z" fill="#B8F5EF" opacity=".9" />
              </svg>
              <h3>Smart Recovery</h3>
              <p>Recover and reuse water, and plan the days after an event with confidence.</p>
            </div>
          </div>
        </section>

        {/* How It Works */}
        <section id="how">
          <h2 className="hd">
            <span><b>From first signal</b></span>
            <span><b>to full recovery.</b></span>
          </h2>
          <div className="steps" id="steps" ref={stepsRef}>
            <div className="line"><i /></div>
            <div className="step"><div className="dot">1</div><div className="glass g-l card"><h3>Observe</h3><p>Gather water and weather conditions.</p></div></div>
            <div className="step"><div className="dot">2</div><div className="glass g-l card"><h3>Predict</h3><p>Anticipate flood and stress risk.</p></div></div>
            <div className="step"><div className="dot">3</div><div className="glass g-l card"><h3>Respond</h3><p>Share clear safety guidance.</p></div></div>
            <div className="step"><div className="dot">4</div><div className="glass g-l card"><h3>Recover</h3><p>Restore and reuse every drop.</p></div></div>
          </div>
        </section>

        {/* Offline / About */}
        <section id="offline">
          <div className="sonar"><i /><i /><i /><b /></div>
          <h2 className="hd">
            <span><b>Intelligence that</b></span>
            <span><b>stays with you.</b></span>
          </h2>
          <p className="lead fade">Because emergency information matters most when connectivity is weakest.</p>
          <div className="grid g3">
            <div className="glass card rv" style={{ '--i': 0 } as React.CSSProperties}>
              <h3>Offline Access</h3>
              <p>Designed so key information stays reachable when the network drops.</p>
            </div>
            <div className="glass card rv" style={{ '--i': 1 } as React.CSSProperties}>
              <h3>Emergency Readiness</h3>
              <p>Safety guidance built to be found fast, under pressure.</p>
            </div>
            <div className="glass card rv" style={{ '--i': 2 } as React.CSSProperties}>
              <h3>Low-Bandwidth Experience</h3>
              <p>Lightweight by design, so it works on slow connections.</p>
            </div>
          </div>
        </section>

        {/* CTA */}
        <section className="cta">
          <h2 className="hd">
            <span><b>Every drop matters.</b></span>
            <span><b>Every prediction counts.</b></span>
          </h2>
          <p className="fade">Build a safer, more water-wise city with intelligence that keeps moving.</p>
          <button className="btn p fade" onClick={handleGetStarted}>Get Started</button>
        </section>
      </main>

      <footer style={{ position: 'relative', zIndex: 2 }}>
        <div className="glass g-l">AQUANET X &copy; 2026. Urban water intelligence.</div>
      </footer>

      <div id="fx" ref={fxRef} />
    </>
  );
}
