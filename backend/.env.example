# AQUANET X Backend Environment Variables

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aquanetx?retryWrites=true&w=majority

# Gemini AI 4-Key Failover Configuration
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: Firebase Admin Service Account Credentials for token verification
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----"
